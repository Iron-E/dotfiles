{
	"define-sink": {
		"body": [
			"(define* (sink input #:key (buf-size 4096))",
			"  \"Redirect an input port to the current output port. ",
			"Use with-output-to-port to change the destination.\"",
			"  (let ((buf (make-bytevector buf-size)))",
			"\t (let loop ((position 0))",
			"\t\t(let ((n (get-bytevector-n! input buf 0 buf-size)))",
			"\t\t  (when (and (not (eof-object? n)) (> n 0))",
			"\t\t\t (put-bytevector (current-output-port) buf 0 n)",
			"\t\t\t (loop (1+ n))))))",
			"  (close-port input))"
		],
		"prefix": "define-sink"
	},
	"let": {
		"body": "(let (${1:(foo (bar))}) ${2:body})$0",
		"prefix": "let"
	},
	"pipefail": {
		"body": [
			"(define* (checkpid pid #:optional (fail-message \"\"))",
			"\t\t\t\"Check the exit code of the pid given, erroring if necessary.\"",
			"\t\t\t(let* ((st (cdr (waitpid pid)))",
			"\t\t\t\t\t (code (or (status:exit-val st) (status:stop-sig st) (status:term-sig st))))",
			"\t\t\t  (unless (zero? st) (display fail-message) (exit code))))"
		],
		"prefix": "pipefail"
	},
	"shebang": {
		"body": [
			"#!/usr/bin/env -S guile -q -s",
			"!#",
			"",
			"$0"
		],
		"prefix": "shebang"
	}
}