{
	"mise": {
		"body": [
			"[settings]",
			"experimental = true",
			"lockfile = true",
			"",
			"[tools]",
			"# TODO: run `mise use lefthook`",
			"",
			"[tasks.lefthook-install]",
			"run = \"lefthook check-install || lefthook install\"",
			"",
			"[[hooks.enter]]",
			"run = \"mise install --locked\"",
			"",
			"[[hooks.enter]]",
			"task = \"lefthook-install\"",
			"",
			"[[watch_files]]",
			"patterns = [\"mise.toml\"]",
			"run = \"mise install\"",
			"",
			"[[watch_files]]",
			"patterns = [\"lefthook.yml\"]",
			"task = \"lefthook-install\""
		],
		"prefix": "mise"
	}
}